# Make a copy called .env and fill in ONLY on your own device. Never commit .env.
CRM_TOKEN=PASTE_YOUR_PRIVATE_TOKEN_HERE
CRM_BASE_URL=https://analyst-assessment-production.up.railway.app/api/v1
# Check the Swagger API docs to confirm path, method and authentication.
CRM_AUTH_STYLE=bearer
CRM_ACCOUNTS_PATH=/accounts
CRM_UPDATE_METHOD=PATCH
CRM_CREATE_METHOD=POST
CRM_PAGE_SIZE=100
# Override only if the create schema uses billing_zip instead of billing_postal_code.
CRM_ZIP_WRITE_FIELD=auto
# Browser URL is optional, for evidence links only.
CRM_BROWSER_URL=
